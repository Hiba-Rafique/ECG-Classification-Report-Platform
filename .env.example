# Application
APP_NAME=ECG Analysis Platform
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite:///./ecg_results.db

# Model (best_model.pth ships with the repo — real inference works out of the box)
MODEL_PATH=./models/weights/best_model.pth
MOCK_INFERENCE=false

# AI report generation (any OpenAI-compatible endpoint)
# Leave AI_API_KEY empty to use the built-in rule-based template report
# Examples:
#   Gemini:     https://generativelanguage.googleapis.com/v1beta/openai/ + gemini-2.5-flash
#   OpenAI:     https://api.openai.com/v1        + gpt-4o-mini
#   Groq:       https://api.groq.com/openai/v1   + llama-3.1-8b-instant
#   OpenRouter: https://openrouter.ai/api/v1      + any model slug
#   Ollama:     http://localhost:11434/v1         + llama3.1 (key can be "ollama")
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-2.5-flash

# Upload
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=csv,dat,hea,edf
